# Browser: 'chrome' | 'edge' | 'auto'
BROWSER=chromium

# Path browser (để trống → auto-detect)
# Kali Linux thường: /usr/bin/chromium
BROWSER_PATH=/workspaces/cs/vmos/.browsers/chromium/linux-1737476/chrome-linux/chrome

# Headless: false (BẮT BUỘC để bypass Cloudflare)
HEADLESS=false

# Port web UI
PORT=3000

# Rotate IP qua WARP
WARP_ENABLED=false

# Auto start Xvfb nếu không có DISPLAY (Linux)
AUTO_XVFB=true
